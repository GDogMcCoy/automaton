# Conway Automaton - Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control!

# ── CORE AUTOMATON CONFIGURATION (Required) ──────────────────────
AUTOMATON_NAME="my-automaton"
CREATOR_ADDRESS=""
CONWAY_API_URL="https://api.conway.tech"
CONWAY_API_KEY=""
SANDBOX_ID=""

# ── INFERENCE CONFIGURATION (Optional - BYOK Support) ───────────
INFERENCE_MODEL="claude-3-5-sonnet"
MAX_TOKENS_PER_TURN="4096"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ── SECURITY CONFIGURATION ──────────────────────────────────────
# Self-modification mode: "disabled" | "gated" | "full"
SELF_MOD_MODE="disabled"
# Replication: set to "true" to allow spawning child automatons
REPLICATION_ENABLED="false"
# Maximum tool execution time in milliseconds
MAX_TOOL_EXECUTION_MS="30000"

# ── DATABASE CONFIGURATION ──────────────────────────────────────
DB_PATH="~/.automaton/state.db"

# ── HEARTBEAT CONFIGURATION ─────────────────────────────────────
HEARTBEAT_CONFIG_PATH="~/.automaton/heartbeat.yml"
HEARTBEAT_INTERVAL_MS="60000"

# ── LOGGING CONFIGURATION ───────────────────────────────────────
LOG_LEVEL="info"
