# Conway Automaton - Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control!

# ── CORE AUTOMATON CONFIGURATION (Required) ──────────────────────
AUTOMATON_NAME="my-automaton"
CREATOR_ADDRESS=""
CONWAY_API_URL="https://api.conway.tech"
CONWAY_API_KEY=""
SANDBOX_ID=""

# ── INFERENCE CONFIGURATION (Optional - BYOK Support) ───────────
INFERENCE_MODEL="claude-3-5-sonnet"
MAX_TOKENS_PER_TURN="4096"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ── SECURITY CONFIGURATION ──────────────────────────────────────
# Self-modification mode: "disabled" | "gated" | "full"
SELF_MOD_MODE="disabled"
# Replication: set to "true" to allow spawning child automatons
REPLICATION_ENABLED="false"
# Maximum tool execution time in milliseconds
MAX_TOOL_EXECUTION_MS="30000"
# Wallet encryption passphrase (strongly recommended for production)
# If set, the wallet private key is encrypted at rest with AES-256-GCM
AUTOMATON_WALLET_PASSPHRASE=""

# ── OPERATOR CONFIGURATION ─────────────────────────────────────
# Standing instructions injected into the agent's system prompt
OPERATOR_INSTRUCTIONS=""
# Comma-separated list of allowed outbound domains (empty = allow all)
# Example: "api.conway.tech,github.com,npmjs.org"
ALLOWED_DOMAINS=""
# Maximum USDC spending per day (in dollars, e.g., "100")
MAX_DAILY_SPENDING_USDC=""

# ── DATABASE CONFIGURATION ──────────────────────────────────────
DB_PATH="~/.automaton/state.db"

# ── HEARTBEAT CONFIGURATION ─────────────────────────────────────
HEARTBEAT_CONFIG_PATH="~/.automaton/heartbeat.yml"
HEARTBEAT_INTERVAL_MS="60000"

# ── LOGGING CONFIGURATION ───────────────────────────────────────
LOG_LEVEL="info"
